package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

genrule {
  name: "fill.comp.spv.h",
  srcs: [
    "fill.comp",
  ],
  out: [
    "fill.comp.spv.h",
  ],
  tools: [
  ],
  cmd: "glslangValidator -V --target-env spirv1.5 -x -o $(location fill.comp.spv.h)" + 
        "$(location fill.comp) -DRS_KEYVAL_DWORDS=2 --quiet",
}

