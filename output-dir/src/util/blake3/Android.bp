package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_defaults {
    name: "blake3_c_flags",
    cflags: [
        "-Wno-error",
    ],
}

cc_library_static {
    name: "blake3",
    host_supported: false,
    srcs: [
        "blake3.c",
        "blake3_dispatch.c",
        "blake3_portable.c",
        "blake3_neon.c",
    ],
    c_std: "c11",
    cpp_std: "c++17",
    defaults: [
        "mesa_c_project_args",
        "mesa_cpp_project_args",
        "blake3_c_flags",
    ],
    
}

