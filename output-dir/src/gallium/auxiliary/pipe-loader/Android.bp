package {
    // See: http://go/android-license-faq
    default_applicable_licenses: ["external_mesa3d_license"],
}

cc_library_static {
    name: "pipe_loader_static",
    host_supported: false,
    srcs: [
        "pipe_loader.c",
        "pipe_loader_sw.c",
        "pipe_loader_drm.c",
    ],
    generated_headers: [
        "shader_stats.h",
        "u_format_gen.h",
    ],
    c_std: "c11",
    cpp_std: "c++17",
    defaults: [
        "mesa_c_project_args",
        "mesa_cpp_project_args",
    ],
    static_libs: [
        "libsync",
        "loader",
        "xmlconfig",
        "mesa_util",
        "blake3",
        "mesa_util_c11",
    ],
    shared_libs: [
        "libdrm",
        "m",
        "libzstd",
        "libcutils",
        "hwvulkan_headers",
        "liblog",
        "libnativewindow",
    ],
    header_libs: [
        "inc_loader",
        "inc_gallium",
        "inc_src",
        "inc_gallium_aux",
        "inc_gallium_winsys",
        "inc_gallium_drivers",
    ]
    
}

